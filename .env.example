# MedGuideAI Environment Configuration Example

# Base URL for SNS Workbench / n8n Webhooks
VITE_API_BASE_URL=https://api.agents.snsihub.ai/webhook

# Direct Discharge Summary Processing Webhook URL (optional, defaults to VITE_API_BASE_URL/discharge-summary/process)
VITE_DISCHARGE_WEBHOOK_URL=https://api.agents.snsihub.ai/webhook/discharge-summary/process

# Toggle mock mode ('false' for live AI / backend, 'true' for local simulation)
VITE_USE_MOCK=false

# Google Gemini API Key for Multimodal Clinical Document Extraction and Translation
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
